# ═══════════════════════════════════════════════════════════════
# AI Shorts System — Configuración
# ═══════════════════════════════════════════════════════════════
# Copiá este archivo como .env y completá tus API keys.
#
# ─── PROVIDER PRIMARIO: OpenRouter ───
# OpenRouter te deja usar OpenAI, Anthropic, Google, Mistral y más
# con UNA sola API key. Registrate gratis: https://openrouter.ai/keys
# ═══════════════════════════════════════════════════════════════

# ── OpenRouter (RECOMENDADO) ──
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku   # Alternativa: mejor para español
# OPENROUTER_MODEL=google/gemini-2.0-flash-001  # Alternativa: gratis (cuota limitada)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://github.com/ai-shorts-system
OPENROUTER_TITLE=AI Shorts System

# ── Proveedor activo (openrouter | openai | anthropic | gemini | mock) ──
AI_PROVIDER=openrouter

# ── OpenAI Directo (solo si NO usás OpenRouter) ──
# OPENAI_API_KEY=sk-tu-api-key-aqui
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ── Anthropic Directo (solo si NO usás OpenRouter) ──
# ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# ── Google Gemini Directo (solo si NO usás OpenRouter) ──
# GEMINI_API_KEY=tu-api-key-aqui

# ── TTS / Voz ──
# ELEVENLABS_API_KEY=tu-api-key-aqui

# ── APIs de Tendencias ──
# YOUTUBE_API_KEY=tu-api-key-aqui
# TWITTER_API_KEY=tu-api-key-aqui
# NEWS_API_KEY=tu-api-key-aqui

# ── Publicación ──
# YOUTUBE_CHANNEL_ID=tu-channel-id
