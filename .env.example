# AI Shorts System - Environment Variables
# ===========================================
# Copia este archivo a .env y completa con tus API keys

# OpenAI (requerido para generación de contenido)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs (TTS - voz)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# YouTube API (publicación y analytics)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id

# Twitter/X API
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here

# News API (tendencias de noticias)
NEWS_API_KEY=your_newsapi_key_here

# Azure Speech (TTS alternativo)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# TikTok API (futuro)
# TIKTOK_CLIENT_KEY=your_tiktok_key_here

# Instagram API (futuro)
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here